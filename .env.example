# Supabase Postgres pooled connection (application runtime)
DATABASE_URL="postgresql://postgres.example:password@example.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres direct connection (reserved for migration workflows)
DIRECT_URL="postgresql://postgres.example:password@example.supabase.co:5432/postgres"

# Supabase project API settings
NEXT_PUBLIC_SUPABASE_URL="https://example-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="example-anon-key"
SUPABASE_SERVICE_ROLE_KEY="example-service-role-key"

# Public marketing deployment settings
# Explicit production marketing origin. Never set this from VERCEL_URL or to a preview deployment.
NEXT_PUBLIC_SITE_URL="https://example.com"
PLUMWORKS_PUBLIC_HOURS="Monday–Friday, 8:00 AM–5:30 PM"
PLUMWORKS_GOOGLE_REVIEW_URL="https://example.com/review"

# Required public lead protection (Contact, Appointment, Drop-Off)
# Public widget key from Cloudflare; configure approved domains in its dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Server-only Siteverify secret; never prefix this with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=""
# Comma-separated exact hostnames (no scheme/path), e.g. www.example.com,example.com.
TURNSTILE_ALLOWED_HOSTNAMES=""
# Server-only random secret, at least 32 characters, stable across all instances.
# Generate separately, for example: openssl rand -hex 32
LEAD_ABUSE_HASH_SECRET=""

# Optional new-lead email notifications (Resend)
MARKETING_LEADS_NOTIFY_EMAIL=""
TRANSACTIONAL_EMAIL_FROM=""
RESEND_API_KEY=""

# Resend SMTP used for Reports and Invoice PDF delivery
# EMAIL_FROM is optional; the default is Car Doc <reports@plumworksapp.com>.
EMAIL_FROM="Car Doc <reports@plumworksapp.com>"

# Operator-only client setup inputs (CLI arguments may be used instead)
PLUMWORKS_SHOP_NAME="Example Repair"
PLUMWORKS_SHOP_ADDRESS="100 Example Street"
PLUMWORKS_SHOP_CITY="Example City"
PLUMWORKS_SHOP_STATE="MI"
PLUMWORKS_SHOP_POSTAL_CODE="00000"
PLUMWORKS_SHOP_PHONE="000-000-0000"
PLUMWORKS_OWNER_EMAIL="owner@example.invalid"
PLUMWORKS_SHOP_SLUG="example-repair"

# Optional explicit selector for maintenance scripts in a multi-shop database
PLUMWORKS_SHOP_ID="00000000-0000-4000-8000-000000000000"
